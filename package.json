{
	"name": "@effect-postcodes/client",
	"version": "0.1.0",
	"description": "Effect-native TypeScript client for the postcodes.io API",
	"keywords": [
		"effect",
		"effect-ts",
		"postcodes",
		"postcodes.io",
		"typescript"
	],
	"license": "MIT",
	"author": "Alan Currie",
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"generate": "openapigen --spec openapi/spec.yaml --name PostcodesApi --format httpclient > generated/PostcodesApi.ts",
		"pull:full-spec": "bun run scripts/pullFullSpec.ts",
		"bundle:full-spec": "bun run pull:full-spec && bun run scripts/bundleFullSpec.ts",
		"normalize:production-spec": "bun run scripts/normalizeProductionSpec.ts && bun node_modules/oxfmt/dist/cli.js --config oxfmt.config.ts openapi/production.bundle.yaml",
		"generate:production": "bun run normalize:production-spec && openapigen --spec openapi/production.bundle.yaml --name PostcodesProduction --format httpclient > generated/PostcodesProduction.ts",
		"generate:full": "bun run bundle:full-spec && openapigen --spec openapi/full-upstream/openapi.bundle.yaml --name PostcodesFull --format httpclient > generated/PostcodesFull.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test test/contract.test.ts test/fullClient.elysia.test.ts test/rateLimiting.test.ts test/schema.property.test.ts test/client.property.test.ts test/normalizeProductionSpec.test.ts test/productionGeneration.test.ts test/postcodeOperations.test.ts",
		"test:live": "bun test test/liveClient.test.ts",
		"check": "bun run typecheck && bun run test",
		"fmt": "bun node_modules/oxfmt/dist/cli.js --config oxfmt.config.ts",
		"fmt:check": "bun node_modules/oxfmt/dist/cli.js --config oxfmt.config.ts --check",
		"lint:code": "bun node_modules/oxlint/dist/cli.js --config oxlint.config.ts",
		"lint:code:fix": "bun node_modules/oxlint/dist/cli.js --config oxlint.config.ts --fix",
		"lint": "publint && attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution",
		"docs:api": "typedoc",
		"docs:api:check": "typedoc --emit none",
		"example:get": "bun run src/programs/getThing.ts",
		"example:create": "bun run src/programs/createThing.ts",
		"example:fail": "bun run src/programs/failureThing.ts",
		"example:full": "bun run src/programs/fullClient.ts",
		"docs:serve": "bun run src/server/serve.ts",
		"docs:dev": "bun run --cwd docs dev",
		"docs:build": "bun run --cwd docs build",
		"docs:preview": "bun run --cwd docs preview",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "bun run build && changeset publish",
		"agent:sync": "flue run sync-upstream --target node",
		"prepublishOnly": "bun run build",
		"pack:dry-run": "npm pack --dry-run"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.3",
		"@changesets/cli": "^2.31.0",
		"@effect/language-service": "0.80.0",
		"@effect/openapi-generator": "4.0.0-beta.101",
		"@effect/platform-node": "4.0.0-beta.101",
		"@flue/cli": "^1.0.0-beta.9",
		"@flue/runtime": "^1.0.0-beta.9",
		"@opsydyn/oxlint-effect": "^0.4.0",
		"@oxlint/plugins": "^1.73.0",
		"@types/node": "24.5.2",
		"bun-types": "^1.3.11",
		"effect": "4.0.0-beta.101",
		"elysia": "^1.3.0",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"publint": "^0.3.21",
		"swagger2openapi": "^7.0.8",
		"tsdown": "^0.22.1",
		"typedoc": "^0.28.19",
		"typescript": "6.0.0-beta",
		"unrun": "^0.3.1",
		"valibot": "^1.4.2",
		"yaml": "^2.8.3"
	},
	"peerDependencies": {
		"@effect/platform-node": "^4.0.0-beta.90",
		"effect": "^4.0.0-beta.90"
	},
	"peerDependenciesMeta": {
		"@effect/platform-node": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
